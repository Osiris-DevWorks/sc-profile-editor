<?xml version="1.0" encoding="UTF-8"?>
<ActionMaps>
 <ActionProfiles version="1" optionsVersion="2" rebindVersion="2" profileName="Keyboard and Mouse - Official Defaults">
  <deviceoptions name="Mouse">
   <option input="@pause_OptionsMouseSmoothing" saturation="0.044999994"/>
   <option input="@pause_OptionsMouseAcceleration" acceleration="0.029999999"/>
  </deviceoptions>
  <options type="keyboard" instance="1" Product="Keyboard  {6F1D2B61-D5A0-11CF-BFC7-444553540000}"/>
  <options type="mouse" instance="1" Product="Mouse"/>
  <modifiers />
  <actionmap name="spaceship_movement">
   <action name="v_strafe_forward">
    <rebind input="kb1_w"/>
   </action>
   <action name="v_strafe_back">
    <rebind input="kb1_s"/>
   </action>
   <action name="v_strafe_left">
    <rebind input="kb1_a"/>
   </action>
   <action name="v_strafe_right">
    <rebind input="kb1_d"/>
   </action>
   <action name="v_strafe_up">
    <rebind input="kb1_space"/>
   </action>
   <action name="v_strafe_down">
    <rebind input="kb1_lctrl"/>
   </action>
   <action name="v_afterburner">
    <rebind input="kb1_lshift"/>
   </action>
   <action name="v_toggle_landing_system">
    <rebind input="kb1_n"/>
   </action>
   <action name="v_autoland">
    <rebind input="kb1_lctrl"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_quantum">
   <action name="v_toggle_qdrive_engagement">
    <rebind input="kb1_b"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_targeting">
   <action name="v_target_toggle_lock_index_1">
    <rebind input="kb1_f8"/>
   </action>
   <action name="v_target_toggle_lock_index_2">
    <rebind input="kb1_f8"/>
   </action>
   <action name="v_target_toggle_lock_index_3">
    <rebind input="kb1_f8"/>
   </action>
   <action name="v_target_toggle_pin_index_1_hold">
    <rebind input="kb1_1"/>
   </action>
   <action name="v_target_toggle_pin_index_2_hold">
    <rebind input="kb1_2"/>
   </action>
   <action name="v_target_toggle_pin_index_3_hold">
    <rebind input="kb1_3"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_targeting_advanced">
   <action name="v_target_cycle_attacker_reset">
    <rebind input="kb1_4"/>
   </action>
   <action name="v_target_cycle_hostile_reset">
    <rebind input="kb1_5"/>
   </action>
   <action name="v_target_cycle_in_view_fwd">
    <rebind input="kb1_6"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_scanning">
   <action name="v_scanning_trigger_scan">
    <rebind input="kb1_v"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_missiles">
   <action name="v_weapon_launch_missile">
    <rebind input="mouse1_button1"/>
   </action>
   <action name="v_weapon_cycle_missile_group">
    <rebind input="mouse1_button2"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_weapon_mgmt">
   <action name="v_weapon_gimbal_toggle">
    <rebind input="kb1_g"/>
   </action>
   <action name="v_weapon_countermeasure_decoy_launch">
    <rebind input="kb1_backspace"/>
   </action>
  </actionmap>
  <actionmap name="spaceship_view">
   <action name="v_view_cycle_forward">
    <rebind input="kb1_z"/>
   </action>
  </actionmap>
  <actionmap name="player">
   <action name="drop">
    <rebind input="kb1_lshift+backslash"/>
   </action>
  </actionmap>
 </ActionProfiles>
</ActionMaps>
